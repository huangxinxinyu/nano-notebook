NANO_DATABASE_URL=postgres://nano:nano@localhost:55432/nano?sslmode=disable
NANO_CONTROL_PLANE_URL=http://localhost:8080
NANO_WORKER_URL=http://localhost:8081
NANO_WEB_URL=http://localhost:5173
NANO_WEB_BASE_URL=http://localhost:5173
NANO_MAIL_SMTP_ADDR=127.0.0.1:51025
NANO_MAIL_FROM=nano@localhost
NANO_MAILPIT_URL=http://localhost:58025
NANO_COLLECTOR_QUERY_TOKEN=nano-local-collector-query-token
NANO_JAEGER_URL=http://localhost:51686
NANO_REPLAY_STAGING_S3_ENDPOINT=127.0.0.1:59000
NANO_REPLAY_STAGING_S3_ACCESS_KEY_ID=nano
NANO_REPLAY_STAGING_S3_SECRET_ACCESS_KEY=nano-password
NANO_REPLAY_STAGING_S3_BUCKET=nano-agent-replay-staging
NANO_REPLAY_S3_ENDPOINT=127.0.0.1:59000
NANO_REPLAY_S3_ACCESS_KEY_ID=nano
NANO_REPLAY_S3_SECRET_ACCESS_KEY=nano-password
NANO_REPLAY_S3_BUCKET=nano-agent-replay
NANO_REPLAY_KEY_ID=nano-local-replay-key-v1
NANO_REPLAY_KEK_BASE64=bmFuby1sb2NhbC1kZXYta2VrLTAwMDAwMDAwMDAwMDA=
NANO_TOOL_RESULT_REDIS_URL=redis://:nano-tool-results@127.0.0.1:56379/0
NANO_TOOL_RESULT_CACHE_TTL=30m
NANO_TOOL_RESULT_INLINE_BYTES=16384
NANO_TOOL_RESULT_PAGE_BYTES=16384
NANO_TOOL_RESULT_MAXIMUM_BYTES=2097152

# Optional E2B credential for Research run_python. Leave empty to hide the tool.
# scripts/start imports this key into the native Worker; never commit real keys.
NANO_E2B_API_KEY=

# Alibaba Cloud Model Studio (DashScope). Local Bifrost uses the China mainland
# endpoint; production uses the international one, so issue keys per region.
# Copy this file to infra/compose/.env and replace the placeholder locally.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
# Google AI Studio key used only for Gemini retrieval embeddings.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional Cohere key for evidence reranking; without it search falls back to RRF.
COHERE_API_KEY=
NANO_GENERATION_PROVIDER=aliyun
NANO_GENERATION_MODEL=qwen-plus
BIFROST_URL=http://localhost:56666
NANO_QDRANT_COLLECTION=nano-source-evidence-gemini-2-768-v1
NANO_QDRANT_DENSE_DIMENSIONS=768
